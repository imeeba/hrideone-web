{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": []
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": { "minViewportWidth": "390px", "maxViewportWidth": "1366px" },
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": false,
			"textDecoration": false,
			"textTransform": true,
			"writingMode": false
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": ["px", "rem", "%", "vw"]
		},
		"shadow": { "defaultPresets": false },
		"border": { "color": true, "radius": true, "style": true, "width": true }
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "300",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--50)",
			"padding": {
				"left": "var(--wp--custom--gutter)",
				"right": "var(--wp--custom--gutter)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary-strong)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--custom--color--teal--800)" }
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--heading)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--heading)"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "lineHeight": "var(--wp--custom--line-height--tight)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "textTransform": "uppercase" } },
			"button": {
				"border": { "radius": "var(--wp--custom--radius--sm)", "width": "2px", "style": "solid", "color": "var(--wp--preset--color--primary-strong)" },
				"color": {
					"background": "var(--wp--preset--color--primary-strong)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.75rem", "right": "1.75rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "500", "lineHeight": "1.2" },
				":hover": {
					"color": { "background": "var(--wp--custom--color--teal--800)" },
					"border": { "color": "var(--wp--custom--color--teal--800)" }
				},
				":focus": {
					"outline": { "color": "var(--wp--preset--color--primary)", "offset": "3px", "style": "solid", "width": "2px" }
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--contrast-muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": { "background": "transparent", "text": "var(--wp--preset--color--primary-strong)" },
						"border": { "color": "var(--wp--preset--color--primary-strong)" }
					}
				}
			},
			"core/site-title": {
				"color": { "text": "var(--wp--preset--color--primary-deep)" },
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--primary-deep)" }, "typography": { "textDecoration": "none" } } },
				"typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "600" }
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "400" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" },
				"border": { "width": "1px" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--primary)", "width": "4px", "style": "solid" } },
				"spacing": { "padding": { "left": "var(--wp--preset--spacing--50)" } }
			},
			"core/post-title": {
				"elements": { "link": { "typography": { "textDecoration": "none" }, "color": { "text": "inherit" } } }
			},
			"core/post-excerpt": {
				"color": { "text": "var(--wp--preset--color--contrast-muted)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
