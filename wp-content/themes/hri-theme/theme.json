				"fast": "150ms",
				"base": "250ms",
				"easing": "cubic-bezier(0.2, 0, 0, 1)"
			},
			"gutter": "var(--wp--preset--spacing--50)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "300",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--50)",
			"padding": {
				"left": "var(--wp--custom--gutter)",
				"right": "var(--wp--custom--gutter)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary-strong)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--custom--color--teal--800)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--heading)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "var(--wp--custom--line-height--tight)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"border": {
					"radius": "var(--wp--custom--radius--sm)",
					"width": "2px",
					"style": "solid",
					"color": "var(--wp--preset--color--primary-strong)"
				},
				"color": {
					"background": "var(--wp--preset--color--primary-strong)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"bottom": "0.85rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var(--wp--custom--color--teal--800)"
					},
					"border": {
						"color": "var(--wp--custom--color--teal--800)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--contrast-muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
