{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hri/contact-info",
	"title": "Contact Info",
	"category": "widgets",
	"icon": "phone",
	"description": "Phone, e-mail, LINE and address from Settings → ข้อมูลบริษัท.",
	"textdomain": "hri-core",
	"supports": {
		"html": false,
		"autoRegister": true,
		"color": {
			"text": true,
			"background": false,
			"link": true
		}
	},
	"render": "file:./render.php",
	"attributes": {
		"items": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": [
				"phone",
				"email",
				"line",
				"address"
			]
		}
	},
	"style": "hri-company"
}
