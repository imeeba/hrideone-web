{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hri/language-switcher",
	"title": "Language Switcher",
	"category": "widgets",
	"icon": "translation",
	"description": "Language switcher. Dropdown for the header on desktop; list for inside the mobile menu. Uses Polylang when active.",
	"textdomain": "hri-core",
	"supports": {
		"html": false,
		"autoRegister": true
	},
	"style": "hri-language",
	"render": "file:./render.php",
	"attributes": {
		"variant": {
			"type": "string",
			"enum": [
				"dropdown",
				"list"
			],
			"default": "dropdown"
		}
	},
	"viewScript": "file:./view.js"
}
